{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["react", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "index.tsx",
    "components/**/*.tsx",
    "sections/**/*.tsx",
    "*.ts",
    "test/**/*.ts"
  ]
}
