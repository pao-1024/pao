println("pao guest event loop")

var moving bool = false
var moveMode int32 = 0
var moveTarget int32 = 0
var moveStart int32 = 0
var moveMoved int32 = 0
var moveStatus int32 = 0
var moveStartMs int32 = 0
var lastState int32 = -1
var event int32 = 0
var exploring bool = false
var explorePhase int32 = 0
var exploreTurns int32 = 0
var exploreReason int32 = 0
var exploreStartMs int32 = 0
var exploreStepMs int32 = 0
var lastTextMs int32 = 0
var standbyActive bool = false
var standbyStartMs int32 = 0
var standbyHeard bool = false


for {
	var timeout int32 = 500
	if moving || seqActive {
		timeout = 100
	}
	if standbyActive {
		timeout = 200
	}
	event = eventNext(timeout)

	if moving {
		now := uptimeMs()
		d := distanceCm()
		if d < 0 {
			move(0, 0)
			moving = false
			moveStatus = 4
		} else if moveMode == 0 {
			moveMoved = moveStart - d
			if moveMoved >= moveTarget {
				move(0, 0)
				moving = false
				moveStatus = 2
			} else if d <= 10 {
				move(0, 0)
				moving = false
				moveStatus = 3
			} else if now-moveStartMs > 15000 {
				move(0, 0)
				moving = false
				moveStatus = 5
			} else {
				move(1, 300)
			}
		} else {
			moveMoved = moveTarget - d
			if d <= moveTarget {
				move(0, 0)
				moving = false
				moveStatus = 2
			} else if d <= 10 {
				move(0, 0)
				moving = false
				moveStatus = 3
			} else if now-moveStartMs > 15000 {
				move(0, 0)
				moving = false
				moveStatus = 5
			} else {
				move(1, 300)
			}
		}
	}

	if standbyActive {
		now := uptimeMs()
		state := deviceState()
		elapsed := now - standbyStartMs
		if state == 6 {
			standbyHeard = true
			if elapsed > 20000 {
				toggleChat()
				standbyActive = false
			}
		} else if state == 3 {
			standbyActive = false
		} else if state == 5 && (standbyHeard || elapsed > 3000) {
			toggleChat()
			standbyActive = false
		} else if elapsed > 30000 {
			standbyActive = false
		}
	}

	if seqActive {
		now := uptimeMs()
		if !seqStepStarted {
			act := seqActions[seqIndex]
			dur := seqDurations[seqIndex]
			if act == 5 {
				fire()
			} else {
				moveSeq(act, dur)
			}
			seqStepEndMs = now + dur
			seqStepStarted = true
		} else if now >= seqStepEndMs {
			if seqActions[seqIndex] != 5 {
				moveSeq(0, 0)
			}
			seqIndex++
			seqStepStarted = false
			if seqIndex >= seqCount {
				seqActive = false
			}
		}
	}

	if exploring {
		now := uptimeMs()
		if now-exploreStartMs > 120000 {
			move(0, 0)
			exploring = false
			explorePhase = 0
			exploreReason = 4
		} else if now-exploreStepMs >= 700 {
			exploreStepMs = now
			d := distanceCm()
			if d < 0 {
				move(0, 0)
				exploring = false
				explorePhase = 7
				exploreReason = 3
			} else if d < 35 {
				explorePhase = 4
				exploreReason = 2
				exploreTurns++
				move(0, 0)
				move(4, 600)
				if exploreTurns >= 6 {
					exploring = false
					explorePhase = 0
					exploreReason = 5
				}
			} else {
				explorePhase = 2
				exploreReason = 1
				move(1, 800)
			}
		}
	}

	if event == 0 {
		if uptimeMs()-lastTextMs > 10000 {
			d := distanceCm()
			showDistance(d)
		}
		state := deviceState()
		if state != lastState {
			showState(state)
			lastState = state
		}
		continue
	}

	id := eventId()
	a := eventArg0()
	b := eventArg1()

	if event == 1 {
		seqActive = false
		moving = false
		exploring = false
		explorePhase = 0
		exploreReason = 6
		if a >= 1 && a <= 4 {
			moveStatus = 0
			move(a, b)
		} else if a == 5 {
			moveStatus = 0
			move(0, 0)
		}
		eventReply(id, 0)
	} else if event == 2 {
		seqActive = false
		exploring = false
		explorePhase = 0
		exploreReason = 6
		if moving {
			move(0, 0)
			moving = false
		}
		d := distanceCm()
		if d < 0 {
			moveStatus = 4
			eventReply(id, -1)
		} else if a == 0 {
			if d-b < 10 {
				moveStatus = 0
				eventReply(id, -2)
			} else {
				moveMode = 0
				moveStart = d
				moveTarget = b
				moveMoved = 0
				moveStartMs = uptimeMs()
				moveStatus = 1
				moving = true
				move(1, 300)
				eventReply(id, 0)
			}
		} else {
			if b < 10 {
				moveStatus = 0
				eventReply(id, -4)
			} else if d <= b {
				moveStatus = 0
				eventReply(id, -3)
			} else {
				moveMode = 1
				moveTarget = b
				moveMoved = b - d
				moveStartMs = uptimeMs()
				moveStatus = 1
				moving = true
				move(1, 300)
				eventReply(id, 0)
			}
		}
	} else if event == 3 {
		moving = false
		move(0, 0)
		moveStatus = 6
		eventReply(id, 0)
	} else if event == 4 {
		eventReply(id, moveStatus)
	} else if event == 5 {
		eventReply(id, moveMoved)
	} else if event == 6 {
		eventReply(id, moveTarget)
	} else if event == 7 {
		seqActive = false
		moving = false
		move(0, 0)
		exploring = true
		explorePhase = 1
		exploreTurns = 0
		exploreReason = 1
		exploreStartMs = uptimeMs()
		exploreStepMs = 0
		eventReply(id, 0)
	} else if event == 8 {
		seqActive = false
		exploring = false
		move(0, 0)
		explorePhase = 0
		exploreReason = 6
		eventReply(id, 0)
	} else if event == 9 {
		eventReply(id, explorePhase)
	} else if event == 10 {
		eventReply(id, exploreTurns)
	} else if event == 11 {
		eventReply(id, exploreReason)
	} else if event == 20 {
		showWake()
		logInt(20)
	} else if event == 21 {
		showState(a)
		logInt(100 + a)
	} else if event == 30 {
		code := parseSequence(readText())
		if code == 0 {
			seqActive = true
			seqIndex = 0
			seqStepStarted = false
			seqStepEndMs = 0
			eventReply(id, 0)
		} else {
			eventReply(id, code)
		}
	} else if event == 31 {
		seqActive = false
		eventReply(id, 0)
	} else if event == 40 {
		exploring = false
		move(0, 0)
		standbyActive = true
		standbyStartMs = uptimeMs()
		standbyHeard = false
		eventReply(id, 0)
	} else if event == 22 {
		lastTextMs = uptimeMs()
		showReceivedText()
		logInt(22)
	} else {
		eventReply(id, -1)
	}
}
