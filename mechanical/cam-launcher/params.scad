// =====================================================================
//  皮筋发射器 —— 完全按卖家结构
//  mechanical/cam-launcher/
//
//  ========== 卖家结构的全部要素（就这些，不多加） ==========
//    ① 成品 TT 减速电机（黄盒，内置 1:48），输出轴 φ5.4
//    ② 电机输出轴【直接穿过】圆板中心 —— 同轴
//    ③ 轴上装一个【销子】，跟着轴转
//    ④ 圆板背面有【凸台】，被销子顶住 → 圆板被推着转
//    ⑤ 销子转到凸台末端就【滑出去】→ 皮筋把圆板拽回
//    ⑥ 圆板前端有【打击臂】，扫过弹丸
//    ⑦ 皮筋一端挂圆板，一端挂固定锚柱
//    （原版无弹仓，手填弹；本版加弹仓实现连发 —— 这是唯一新增）
//
//  ========== 坐标 ==========
//    X = 发射方向（0 = 尾端，base_x = 枪口）
//    Y = 电机轴向（圆板在 -Y 端，电机在 +Y）
//    Z = 垂直（0 = 桌面）
// =====================================================================

$fn = 96;

/* ================= 底板 ================= */
base_x   = 150;
base_y   = 110;
base_t   = 6;
corner_r = 4;

/* ================= 弹道 ================= */
Y_L       = -20;    // 弹道中心线（= 圆板所在 Y，打击臂与弹丸同层）
rail_gap  = 13;     // 通道净宽
wall      = 2.4;
rail_x0   = 74;     // 敞开段起点（打击臂从这里进入）
rail_x1   = 92;     // 敞开段终点（与筒口相接）
barrel_x0 = 92;     // 弹道筒起点（打击块推弹之后，筒体封闭加速段）
barrel_x1 = 150;
barrel_h  = 26;     // 筒顶高度（底板顶面以上）

/* ================= 弹丸 ================= */
ball_d = 11;
feed_x = 88;       // 弹仓落弹点
mag_h  = 40;
rail_h = 14;        // 敞开段导轨高（弹仓坐在导轨顶面）

/* ================= 圆板（= 卖家白色圆板） ================= */
P_x    = 64;        // 枢轴 X = 电机轴心
P_z    = 38;        // 枢轴 Z = 电机轴心高
plate_r = 14;       // 圆板半径
plate_t = 5;        // 圆板厚

// 打击臂：臂端正好落在弹丸中心
arm_dx = 79 - P_x;                // 打击块中心 x=79
arm_dz = P_z - (base_t + ball_d/2);  // 26.5
arm_r  = sqrt(arm_dx*arm_dx + arm_dz*arm_dz);
arm_ang = atan2(arm_dz, arm_dx);     // 自 +X 向下

// 凸台（被销子顶的那块）：位于圆板背面，朝 +X 方向伸
lobe_r0 = 6;        // 凸台内端半径（必须 < post_r）
lobe_r1 = 21;       // 凸台外端半径
lobe_ang = 172;     // 凸台中心角（自 +X 量，逆时针）
lobe_w  = 7;        // 凸台宽

/* ================= 销子（装在电机轴上） ================= */
post_r = 9.5;       // 销子回转半径（要夹在 lobe_r0 与 lobe_r1 之间）
post_d = 6;         // 销子直径
post_y0 = -17.5;    // 销子套起始 Y（紧贴圆板背面）
plate_y = -20;      // 圆板所在 Y（= 弹道中心）
post_t  = 3;        // 销子套厚

/* ================= 成品 TT 减速电机 ================= */
motor_l = 70;       // 轴长方向
motor_w = 22;
motor_h = 18;
motor_shaft_d = 5.4;
motor_shaft_out = 9;      // 每端伸出
motor_y0 = -11.5;         // 电机本体起始 Y（轴伸出 9mm 到 -20.5）
motor_y1 = motor_y0 + motor_l;

/* ================= 皮筋 ================= */
anchor_x = 12;
anchor_z = 50;

/* ================= 紧固件 ================= */
screw_d = 2.4;
