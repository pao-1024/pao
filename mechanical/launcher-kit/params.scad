// =====================================================================
//  PAO 发射器机械件 —— 全局参数
//  所有零件共用本文件，改这里即整体联动
//
//  坐标系：
//    X = 发射方向（0 = 尾端，base_x = 前端枪口）
//    Y = 横向（0 = 弹道中心线）
//    Z = 垂直（0 = 桌面，底板占 0..base_t）
//
//  工作原理（决定了下述拓扑）：
//    电机轴沿 Y 横穿；摩擦轮装在轴上、悬在弹道正上方。
//    弹丸靠重力从喉部落到轮下，被轮缘压住甩向 +X。
//    单轮从上方压弹 → 弹仓必须与轮共位，喉部即弹仓。
// =====================================================================

$fn = 96;

/* ================= 底板 ================= */
base_x    = 100;    // 底板长
base_y    = 65;     // 底板宽
base_t    = 6;      // 底板厚
corner_r  = 3;      // 底板圆角

/* ================= 弹道通道 ================= */
rail_gap  = 13;     // 通道净宽（issue #61 图上标注）
bar_wall  = 2.4;    // 筒壁厚
bar_x0    = 2;      // 筒/喉部起点 X
bar_x1    = 98;     // 筒终点 X（前端枪口）
throat_x1 = 38;     // 喉部终点 X（此后加盖成封闭弹道）
wall_top  = 22;     // 侧壁高（底板顶面以上）
throat_h  = 64;     // 喉部总高（须在轮顶之上留出储弹空间，至少 2 发）
bar_top_h = 4;      // 顶盖厚

/* ================= 弹丸 ================= */
ball_d    = 11;     // 纸团压实后直径

/* ================= 摩擦轮 ================= */
fw_r      = 12;     // 轮半径
fw_t      = 8;      // 轮宽
fw_x      = 24;     // 轮轴 X
shaft_d   = 4;      // 钢轴直径
fw_squeeze = 1;     // 轮缘压入弹丸的量
fw_zc     = base_t + ball_d - fw_squeeze + fw_r;   // 轴心高度（推导 = 28）

/* ================= 驱动组 ================= */
motor_d   = 24.4;   // 电机外径（130 型）
motor_clamp_l = 18; // 夹持长度
br_wall   = 6;      // 支架立板厚
br_y      = rail_gap / 2 + bar_wall + 2;   // 立板起始 Y（= 10.9）

/* ================= 弹仓 ================= */
mag_len   = throat_x1 - bar_x0 - bar_wall;  // 喉部可用储弹长
mag_d     = rail_gap;                        // 储弹腔内径 ≡ 通道宽

/* ================= 按钮座 ================= */
sw_d      = 12.2;   // 点触开关安装孔
sw_mount_x = 92;
sw_mount_y = -24;

/* ================= 送弹斜坡 ================= */
ramp_x0   = 4;      // 斜坡起点 X
ramp_x1   = 20;     // 斜坡终点 X（落入摩擦轮咬入区）
ramp_h    = 10;     // 斜坡起端高出底板顶面的量

/* ================= 紧固件 ================= */
screw_d   = 2.4;    // 自攻螺钉过孔
