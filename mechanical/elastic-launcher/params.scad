// =====================================================================
//  皮筋储能自动循环发射器 —— 全局参数
//  mechanical/elastic-launcher/
//
//  坐标系：
//    X = 发射方向（0 = 尾端，base_x = 前端枪口）
//    Y = 横向（0 = 弹道中心线）
//    Z = 垂直（0 = 桌面，底板占 0..base_t）
//
//  机构链：
//    电机 → 两级齿轮 1:25 → 曲柄盘 → C 形拨叉拖滑块后移（皮筋张紧）
//    → 曲柄销脱出拨叉 → 皮筋释放 → 击针前冲击发 → 曲柄销重新咬合
//
//  一次循环 = 曲柄盘转一圈 = 一发
// =====================================================================

$fn = 96;

/* ================= 底板 ================= */
base_x    = 120;
base_y    = 65;
base_t    = 6;
corner_r  = 3;

/* ================= 弹道 ================= */
bore      = 13;     // 通道内宽
barrel_x0 = 74;     // 筒起点
barrel_x1 = 120;    // 枪口
wall      = 2.4;    // 壁厚
barrel_h  = 22;     // 侧壁高（底板顶面起）

/* ================= 弹丸 ================= */
ball_d    = 11;
feed_x    = 82;     // 弹仓落弹点 X（须在击针静止位之前）
mag_h     = 40;     // 弹仓高出筒顶

/* ================= 皮筋储能 ================= */
band_n    = 3;      // 皮筋根数（并联）
band_k    = 80;     // 单根刚度 N/m
stroke    = 22;     // 击发行程 = 皮筋拉伸量（受底板长度限制）
pinion_x  = 28;     // 齿条驱动小齿轮中心 X
anchor_x  = 108;    // 皮筋前锚点 X

/* ================= 击发滑块 ================= */
sled_w    = 14;     // 滑块宽
sled_body_l = 30;   // 滑块本体长
rod_l     = 22;     // 击针长
rod_d     = 4;      // 击针直径

/* ================= 齿轮（两级 1:25） ================= */
gear_m    = 1.0;    // 模数
gear_pa   = 20;     // 压力角（度）
z_small   = 10;
z_big     = 50;
gear_t    = 6;      // 齿轮厚
shaft_d   = 3.0;    // 轴径（打印轴或钢轴）

// 中心距 = (z1+z2)*m/2 = 30
center_d  = (z_small + z_big) * gear_m / 2;

// 电机
motor_d   = 24.4;   // 130 型外壳直径
motor_l   = 38;
motor_x   = 88;     // 与输出小齿轮同轴
motor_z   = 22;      // 与齿轮轴同高

// 齿轮层（Y 方向错开，避免 50 齿互相干涉）
layer1_y  = 15;
layer2_y  = 23;

/* ================= 紧固件 ================= */
screw_d   = 2.4;
m3_d      = 3.4;
