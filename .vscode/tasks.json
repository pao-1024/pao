{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PAO: configure",
      "type": "process",
      "command": "task",
      "args": ["firmware:build", "ACTION=configure"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "PAO: build",
      "type": "process",
      "command": "task",
      "args": ["firmware:build"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    }
  ]
}
